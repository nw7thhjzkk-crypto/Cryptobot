# Alpaca API Key
ALPACA_API_KEY=your_api_key_here
# Alpaca Secret Key
ALPACA_SECRET_KEY=your_secret_key_here
# Full JSON key for Google Service Account, single-line secret
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# Google Sheet ID
GOOGLE_SHEET_ID=your_sheet_id_here
# true for paper trading, false for live
PAPER_MODE=true
# Comma-separated tickers for watchlist
WATCHLIST=AAPL,MSFT,SPY
# Comma-separated tickers allowed to use mean-reversion sleeve
MEAN_REVERSION_ELIGIBLE=SPY
# Polling interval in seconds
POLL_INTERVAL_SECONDS=60
# Max minutes for the loop to run
LOOP_MAX_MINUTES=350
# Risk per trade percentage
RISK_PER_TRADE_PCT=0.01
# Max total risk percentage
MAX_TOTAL_RISK_PCT=0.06
# Max drawdown percentage
MAX_DRAWDOWN_PCT=0.10